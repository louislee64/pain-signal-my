INTELLIGENCE_DATABASE_URL=postgresql+psycopg://pain_radar:pain_radar@postgres:5432/pain_radar
INTELLIGENCE_REDIS_URL=redis://redis:6379/0
SOURCES_REGISTRY_PATH=/config/sources.yaml
TOPICS_REGISTRY_PATH=/config/topics.yaml
SIGNAL_RULES_PATH=/config/signal_rules.yaml
SCORING_CONFIG_PATH=/config/scoring.yaml
LLM_CONFIG_PATH=/config/llm.yaml
EVAL_CASES_PATH=/app/evaluation/cases.yaml

# Only needed if config/llm.yaml sets `provider: anthropic`. LLM extraction is
# disabled by default and nothing here spends money until you enable it —
# see docs/llm-providers.md.
# ANTHROPIC_API_KEY=

# Reddit Data API (PROJECT_SPEC.md §17). Only needed if you enable a
# `reddit_subreddit` source in config/sources.yaml — all three ship disabled.
#
# Create a "script" app at https://www.reddit.com/prefs/apps: the client ID is
# the string under the app name, the secret is the `secret` field.
#
# REDDIT_USERNAME is optional but recommended — Reddit's documented User-Agent
# shape is `<platform>:<app id>:<version> (by /u/<username>)` and it throttles
# generic agents hard. A contact URL is sent when it is absent.
#
# BEFORE ENABLING: Reddit's Data API terms restrict commercial use and §6 gives
# this project commercial intent. That conflict is a licensing decision, not a
# technical one — read docs/text-sources.md.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
